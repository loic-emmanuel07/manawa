# The mode of the running app (optionel)
# Soit "DEV" ou "RELEASE"
MODE="DEV"

# URL de connexion à la base de données (requise)
DATABASE_URL=""

# URL Supabase du projet (requise)
SUPABASE_URL=""

# Clé secrète "service_role" Supabase (requise)
# ⚠️ PAS la clé "anon/publishable" : celle-ci bypass la RLS, ne jamais l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=""

# PORT DU SERVEUR (optionel, 3000 par défaut)
PORT=3000

# ORIGINE AUTORISÉE POUR LE CORS (HTTP + WebSocket), ex: http://localhost:5173
# (optionel, "*" par défaut)
CORS_ORIGIN=*